{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "rootDir": "../",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "rootDirs": ["./src", "../shared"],
    "paths": {
      "@shared/*": ["../shared/types/*"],
      "@shared-config/*": ["../shared/config/*"]
    },
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
