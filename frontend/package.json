{
  "name": "sale-dashboard-frontend",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern \"**/*.d.ts\" src",
